#!/usr/bin/env bash
# Wrapper: runs phoenix.py inside its venv, creating the venv if needed.
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
VENV="$SCRIPT_DIR/.venv"

if [ ! -f "$VENV/bin/python" ]; then
  python3 -m venv "$VENV"
  "$VENV/bin/pip" install --quiet pyswisseph
fi

exec "$VENV/bin/python" "$SCRIPT_DIR/phoenix.py" "$@"
