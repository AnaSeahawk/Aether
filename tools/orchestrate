#!/usr/bin/env bash
set -euo pipefail

default_workspace="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
workspace="$(realpath -m "${ORCHESTRATE_WORKSPACE_ROOT:-$default_workspace}")"

ROLES=(researcher writer curator analyst)

usage() {
  cat <<'EOF'
Usage:
  tools/orchestrate claim <role> [--lane <session>] <path> [more-paths] -- <reason>
  tools/orchestrate release <role> [--lane <session>]
  tools/orchestrate status

Roles: researcher, writer, curator, analyst

Session lanes are optional, lowercase identifiers such as caraka-notes.
Without --lane, the role keeps its original single-lane behavior.

Paths: absolute paths to files or directories.
Claiming a directory covers all files under it.

Lock files (<role>.lock or <role>--<session>.lock) are plain text.
Empty means idle.
Each line is one claimed path, optionally followed by # reason:
  /home/bird/Git/aether/Components/bibliography/ayurveda # pulling Caraka quotes
EOF
}

valid_role() {
  local candidate="$1"
  local role
  for role in "${ROLES[@]}"; do
    [ "$role" = "$candidate" ] && return 0
  done
  return 1
}

valid_lane() {
  local candidate="$1"
  [[ "$candidate" =~ ^[a-z]([a-z0-9-]{0,62}[a-z0-9])?$ ]]
}

lane_key() {
  local role="$1"
  local lane="$2"
  if [ "$lane" = "$role" ]; then
    printf '%s\n' "$role"
  else
    printf '%s--%s\n' "$role" "$lane"
  fi
}

lock_path() {
  local role="$1"
  local lane="$2"
  valid_role "$role" || { printf 'unknown role: %s\n' "$role" >&2; exit 64; }
  valid_lane "$lane" || { printf 'invalid lane: %s\n' "$lane" >&2; exit 64; }
  printf '%s/%s.lock\n' "$workspace" "$(lane_key "$role" "$lane")"
}

all_lock_paths() {
  local role lock
  for role in "${ROLES[@]}"; do
    printf '%s\n' "$(lock_path "$role" "$role")"
  done
  for role in "${ROLES[@]}"; do
    for lock in "$workspace/$role"--*.lock; do
      [ -f "$lock" ] && printf '%s\n' "$lock"
    done
  done
}

normal_path() {
  realpath -m "$1"
}

write_lock() {
  local role="$1"
  local lane="$2"
  local reason="${3:-}"
  shift 3 || true
  local lock temporary
  lock="$(lock_path "$role" "$lane")"
  temporary="$(mktemp "$workspace/.orchestrate-lock.XXXXXX")"

  local path
  for path in "$@"; do
    if [ -n "$reason" ]; then
      printf '%s # %s\n' "$(normal_path "$path")" "$reason" >> "$temporary"
    else
      printf '%s\n' "$(normal_path "$path")" >> "$temporary"
    fi
  done
  mv "$temporary" "$lock"
}

active_paths() {
  local lock="$1"
  [ -f "$lock" ] || return 0
  awk '
    /^[[:space:]]*$/ { next }
    /^[[:space:]]*#/ { next }
    {
      sub(/[[:space:]]+#.*$/, "")
      sub(/[[:space:]]+$/, "")
      sub(/^[[:space:]]+/, "")
      if ($0 != "") print $0
    }
  ' "$lock"
}

paths_overlap() {
  local left right
  left="$(normal_path "$1")"
  right="$(normal_path "$2")"
  [ "$left" = "$right" ] && return 0
  [[ "$left" == "$right"/* ]] && return 0
  [[ "$right" == "$left"/* ]] && return 0
  return 1
}

lock_identity() {
  local name
  name="$(basename "$1" .lock)"
  if [[ "$name" == *--* ]]; then
    printf '%s/%s\n' "${name%%--*}" "${name#*--}"
  else
    printf '%s\n' "$name"
  fi
}

print_lock() {
  local identity="$1"
  local lock="$2"
  printf -- '--- %s ---\n' "$identity"
  if [ -s "$lock" ]; then
    cat "$lock"
  else
    printf '%s\n' '(idle)'
  fi
}

print_state() {
  local role lock
  for role in "${ROLES[@]}"; do
    lock="$(lock_path "$role" "$role")"
    print_lock "$role.lock" "$lock"
  done
  for role in "${ROLES[@]}"; do
    for lock in "$workspace/$role"--*.lock; do
      [ -s "$lock" ] || continue
      print_lock "$(lock_identity "$lock")" "$lock"
    done
  done
}

claim() {
  local role="$1"
  shift
  valid_role "$role" || { usage >&2; exit 64; }
  local lane="$role"

  if [ "${1:-}" = "--lane" ]; then
    [ "$#" -ge 3 ] || { usage >&2; exit 64; }
    lane="$2"
    valid_lane "$lane" || {
      printf 'invalid lane: %s\n' "$lane" >&2
      usage >&2
      exit 64
    }
    shift 2
  fi

  local paths=()
  local reason=''
  while [ "$#" -gt 0 ]; do
    if [ "$1" = "--" ]; then
      shift
      reason="${*:-}"
      break
    fi
    paths+=("$1")
    shift
  done

  if [ "${#paths[@]}" -eq 0 ]; then
    usage >&2
    exit 64
  fi

  write_lock "$role" "$lane" "$reason" "${paths[@]}"
  print_state

  local own_lock peer_lock peer_path own_path conflict=0
  own_lock="$(lock_path "$role" "$lane")"
  while IFS= read -r peer_lock; do
    [ "$peer_lock" = "$own_lock" ] && continue
    while IFS= read -r peer_path; do
      for own_path in "${paths[@]}"; do
        if paths_overlap "$own_path" "$peer_path"; then
          printf 'Conflict: %s overlaps %s (held by %s)\n' \
            "$(normal_path "$own_path")" "$peer_path" \
            "$(lock_identity "$peer_lock")" >&2
          conflict=1
        fi
      done
    done < <(active_paths "$peer_lock")
  done < <(all_lock_paths)

  if [ "$conflict" -ne 0 ]; then
    write_lock "$role" "$lane" ''
    printf '%s\n' 'Claim cleared because of overlap.'
    print_state
    exit 2
  fi
}

release() {
  local role="$1"
  shift
  valid_role "$role" || { usage >&2; exit 64; }
  local lane="$role"
  if [ "${1:-}" = "--lane" ]; then
    [ "$#" -eq 2 ] || { usage >&2; exit 64; }
    lane="$2"
    valid_lane "$lane" || {
      printf 'invalid lane: %s\n' "$lane" >&2
      usage >&2
      exit 64
    }
    shift 2
  fi
  [ "$#" -eq 0 ] || { usage >&2; exit 64; }
  write_lock "$role" "$lane" ''
  print_state
}

case "${1:-}" in
  claim)
    shift
    [ "$#" -ge 2 ] || { usage >&2; exit 64; }
    claim "$@"
    ;;
  release)
    shift
    [ "$#" -ge 1 ] || { usage >&2; exit 64; }
    release "$@"
    ;;
  status)
    print_state
    ;;
  -h|--help|help|'')
    usage
    ;;
  *)
    usage >&2
    exit 64
    ;;
esac
